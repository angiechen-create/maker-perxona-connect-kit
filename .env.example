# Copy to .env and fill in. .env is git-ignored — never commit it.

# Which folder under events/ this kiosk serves.
EVENT_SLUG=demo   # the made-up demo event; your own: events/<your-slug>/

# ── Perxona Connect ──────────────────────────────────────────────
# Perxona Console → Organization → Integration → Connect API keys.
# Each key is shown once; copy it before closing the dialog.
#   SECRET: leave its allowed-domain list EMPTY (server-to-server calls send no Origin).
#   PUBLISHABLE: goes to the browser. Restrict its domains to your site's domain (README, step 2).
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=
# Must be the same region as PERXONA_API_BASE_URL.
PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js

# ── AI answers ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Required: a model ID from your Anthropic account.
LLM_MODEL=
# LLM_EFFORT=low

# ── Server ───────────────────────────────────────────────────────
# PORT=8090
# HOST=127.0.0.1    # 0.0.0.0 exposes it to the venue network — only if you mean to

# ── Staff page (/staff/) ─────────────────────────────────────────
# One shared password for the people running the kiosk. Empty = page off.
# On a public host use a long random one (12+ characters).
STAFF_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────
# PUBLIC_URL=https://your-site.example    # the address QR codes and link previews use
# DATA_DIR=/var/data                      # where check-ins, staff edits and daily counts are kept
# CHECKIN_SECRET=                         # signs check-in tokens; made and kept in DATA_DIR if empty
# TRUST_PROXY=1                           # behind Render / Cloudflare: read the visitor's real address
# QUESTION_LIMIT=20                       # questions per phone (event.yaml kiosk.question_limit wins)
# MAX_QUESTIONS_PER_HOUR=1500             # the whole event, per hour
# MAX_VOICE_PER_DAY=1000                  # paid voice lines per day, all voices together
#
# Maker's voice from ElevenLabs instead of Perxona's own voices:
# VOICE_PROVIDER=elevenlabs               # elevenlabs (default: Perxona's own voices)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=                    # an id, or zh:ID,en:ID,ja:ID
# OPENAI_API_KEY=                        # only for trying an OpenAI voice (?tts=openai)
#
# A Slack message when the Perxona credits run low or run out:
# SLACK_WEBHOOK_URL=                      # a Slack incoming webhook (https://hooks.slack.com/…)
# CREDIT_ALERT_BELOW=                     # points that count as low (default: 20% of the plan)

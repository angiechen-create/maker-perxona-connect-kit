{
  "name": "maker-perxona-connect-kit",
  "version": "0.1.0",
  "description": "A live Perxona avatar concierge for community events. Everything event-specific lives in events/<slug>/.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env server/index.mjs",
    "dev": "node --env-file=.env --watch-path=server server/index.mjs",
    "catalog": "node --env-file=.env scripts/catalog.mjs",
    "rehearse": "node --env-file=.env scripts/rehearse.mjs",
    "import-form": "node --env-file=.env scripts/import-form.mjs",
    "og": "node --env-file=.env scripts/og.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "yaml": "^2.6.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/angiechen-create/maker-perxona-connect-kit.git"
  }
}
